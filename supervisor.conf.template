[supervisord]
nodaemon=true
logfile=/dev/null
logfile_maxbytes=0

[program:xvfb]
command=Xvfb $DISPLAY -screen 0 1024x768x24 -listen tcp -ac
startsecs=0
autorestart=false
startretries=1
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:x11vnc]
command=x11vnc -display $DISPLAY -forever -shared -bg -passwd $PASS
startsecs=5
autorestart=false
startretries=1
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:fluxbox]
command=fluxbox
startsecs=10
autorestart=false
startretries=2
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:websockify]
command=websockify --web /usr/share/novnc 8080 localhost:5900
startsecs=15
autorestart=false
startretries=2
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true